# Wallpapers are large, personal, and regenerable. Both picker scripts default
# to ~/Pictures/Wallpapers, which lives outside this repo.
Pictures/Wallpapers/

# Editor and OS noise
*.swp
*~
.DS_Store
Thumbs.db

# Local scratch
*.log
*.tmp
scratch/

# Byte-compiled python (a stray __pycache__ showed up under wayle/scripts)
__pycache__/
*.py[cod]

# Editor backup copies. hypr/ and matugen/ both accumulated these.
*.bak
*.bak-*

# Unreferenced rofi launcher variants and images. Kept out of the repo because
# nothing in the rice loads them: only colors/colors.rasi, launchers/type-1/
# calc.rasi and launchers/type-1/style-9.rasi are actually referenced (by
# hypr/scripts/*.rasi, wallpaper-picker.sh, theme-switcher.sh and binds.lua).
# The rest came from an older Axolotl install and is ~1.4MB of dead weight.
.config/rofi/launchers/type-2/
.config/rofi/launchers/type-6/
.config/rofi/images/

# Local override hooks, if you keep any
install.local.sh