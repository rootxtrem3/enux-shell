{
    "label" : "lock",
    "action" : "loginctl lock-session",

    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "hyprshutdown",

    "keybind" : "o"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",

    "keybind" : "s"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",

    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",

    "keybind" : "r"
}
