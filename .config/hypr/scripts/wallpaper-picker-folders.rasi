@import "~/.config/rofi/colors/colors.rasi"

configuration {
    show-icons: true;
}

* {
    bg:       @background;
    bg-alt:   @background-alt;
    fg:       @foreground;
    accent:   @selected;

    background-color: transparent;
    text-color:        @fg;
}

window {
    width:              500px;
    height:             450px;
    location:           center;
    anchor:             center;
    transparency:       "real";
    background-color:   @bg;
    border:             2px;
    border-color:       @accent;
    border-radius:      12px;
    padding:            12px;
}

mainbox {
    children:  [ inputbar, listview ];
    spacing:   12px;
    background-color: transparent;
}

inputbar {
    children:        [ prompt, entry ];
    background-color: @bg-alt;
    border-radius:    8px;
    padding:          10px 12px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search...";
    text-color:  @fg;
}

listview {
    columns:            3;
    lines:              3;
    spacing:             8px;
    fixed-columns:       true;
    fixed-height:        true;
    background-color:    transparent;
    cycle:               true;
}

element {
    padding:           12px 8px;
    border-radius:     8px;
    background-color:  @bg-alt;
    cursor:            pointer;
}

element selected {
    background-color: @accent;
}

element-icon {
    size:               74px 74px;
    expand:             true;
    background-color:   transparent;
}

element-text {
    enabled:            true;
    background-color:   transparent;
    text-color:         @fg;
    horizontal-align:   0.0;
    vertical-align:     0.5;
    padding:            0px 0px 0px 8px;
}
