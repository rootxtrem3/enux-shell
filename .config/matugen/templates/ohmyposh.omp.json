{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "[[colors.primary_container.default.hex]]",
          "foreground": "[[colors.on_primary_container.default.hex]]",
          "leading_diamond": "\u256d\u2500\ue0b6",
          "style": "diamond",
          "template": "\uf120 {{ .Name }} ",
          "type": "shell"
        },
        {
          "background": "[[colors.error_container.default.hex]]",
          "foreground": "[[colors.on_error_container.default.hex]]",
          "style": "diamond",
          "template": "<parentBackground>\ue0b0</> \uf292 ",
          "type": "root"
        },
        {
          "background": "[[colors.secondary_container.default.hex]]",
          "foreground": "[[colors.on_secondary_container.default.hex]]",
          "powerline_symbol": "\ue0b0",
          "options": {
            "folder_icon": " \uf07b ",
            "home_icon": "\ue617",
            "style": "folder"
          },
          "style": "powerline",
          "template": "\uf07b\u200b\uea9c\u200b{{ .Path }}",
          "type": "path"
        },
        {
          "background": "[[colors.tertiary_container.default.hex]]",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}[[colors.primary_container.default.hex]]{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}[[colors.secondary_container.default.hex]]{{ end }}",
            "{{ if gt .Ahead 0 }}[[colors.primary.default.hex]]{{ end }}",
            "{{ if gt .Behind 0 }}[[colors.secondary.default.hex]]{{ end }}"
          ],
          "foreground": "[[colors.on_tertiary_container.default.hex]]",
          "powerline_symbol": "\ue0b0",
          "options": {
            "branch_icon": "\ue725 "
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<[[colors.error.default.hex]]> \uf046 {{ .Staging.String }}</>{{ end }} ",
          "type": "git"
        },
        {
          "background": "[[colors.surface_container_highest.default.hex]]",
          "foreground": "[[colors.on_surface.default.hex]]",
          "options": {
            "style": "roundrock",
            "threshold": 0
          },
          "style": "diamond",
          "template": " \ueba2\u200b{{ .FormattedMs }}\u2800",
          "trailing_diamond": "\ue0b4",
          "type": "executiontime"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "[[colors.primary_container.default.hex]]",
          "foreground": "[[colors.on_primary_container.default.hex]]",
          "leading_diamond": "\ue0b6",
          "options": {
            "fetch_package_manager": true,
            "npm_icon": " <[[colors.on_primary_container.default.hex]]>\ue5fa</> ",
            "yarn_icon": " <[[colors.on_primary_container.default.hex]]>\ue6a7</>"
          },
          "style": "diamond",
          "template": "\ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "node"
        },
        {
          "background": "[[colors.secondary_container.default.hex]]",
          "foreground": "[[colors.on_secondary_container.default.hex]]",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "python"
        },
        {
          "background": "[[colors.tertiary_container.default.hex]]",
          "foreground": "[[colors.on_tertiary_container.default.hex]]",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\ue738 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "java"
        },
        {
          "background": "[[colors.primary_fixed.default.hex]]",
          "foreground": "[[colors.on_primary_fixed.default.hex]]",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\ue77f {{ if .Unsupported }}\uf071{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "dotnet"
        },
        {
          "background": "[[colors.tertiary_fixed.default.hex]]",
          "foreground": "[[colors.on_tertiary_fixed.default.hex]]",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\ue626 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "go"
        },
        {
          "background": "[[colors.error_container.default.hex]]",
          "foreground": "[[colors.on_error_container.default.hex]]",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\ue7a8 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "rust"
        },
        {
          "background": "[[colors.primary_fixed_dim.default.hex]]",
          "foreground": "[[colors.on_primary_fixed.default.hex]]",
          "leading_diamond": " \ue0b6",
          "style": "diamond",
          "template": "\ue798 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "dart"
        },
        {
          "background": "[[colors.tertiary_fixed_dim.default.hex]]",
          "foreground": "[[colors.on_tertiary_fixed.default.hex]]",
          "leading_diamond": " \ue0b6",
          "style": "diamond",
          "template": "\ue753 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "angular"
        },
        {
          "background": "[[colors.inverse_surface.default.hex]]",
          "foreground": "[[colors.inverse_primary.default.hex]]",
          "leading_diamond": " \ue0b6",
          "style": "diamond",
          "template": "{{ if .Error }}{{ .Error }}{{ else }}Nx {{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "nx"
        },
        {
          "background": "[[colors.secondary_container.default.hex]]",
          "foreground": "[[colors.on_secondary_container.default.hex]]",
          "leading_diamond": " \ue0b6",
          "style": "diamond",
          "template": "<[[colors.error.default.hex]]>\ue624</> {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "julia"
        },
        {
          "background": "[[colors.tertiary_container.default.hex]]",
          "foreground": "[[colors.on_tertiary_container.default.hex]]",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\ue791 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "ruby"
        },
        {
          "background": "[[colors.primary_container.default.hex]]",
          "foreground": "[[colors.on_primary_container.default.hex]]",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\uf104<[[colors.on_primary_container.default.hex]]>\uf0e7</>\uf105 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "azfunc"
        },
        {
          "background": "[[colors.primary_fixed_dim.default.hex]]",
          "foreground": "[[colors.on_primary_fixed.default.hex]]",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\ue7ad {{.Profile}}{{if .Region}}@{{.Region}}{{end}}",
          "trailing_diamond": "\ue0b4 ",
          "type": "aws"
        },
        {
          "background": "[[colors.tertiary_fixed.default.hex]]",
          "foreground": "[[colors.on_tertiary_fixed.default.hex]]",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\uf308 {{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}}",
          "trailing_diamond": "\ue0b4",
          "type": "kubectl"
        },
        {
          "background": "[[colors.error_container.default.hex]]",
          "foreground": "[[colors.on_error_container.default.hex]]",
          "leading_diamond": "\ue0b6",
          "options": {
            "linux": "\ue712",
            "macos": "\ue711",
            "windows": "\ue70f"
          },
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "type": "os"
        },
        {
          "background": "[[colors.primary_fixed_dim.default.hex]]",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}[[colors.tertiary_container.default.hex]]{{end}}",
            "{{if eq \"Discharging\" .State.String}}[[colors.primary_container.default.hex]]{{end}}",
            "{{if eq \"Full\" .State.String}}[[colors.primary.default.hex]]{{end}}"
          ],
          "foreground": "[[colors.on_primary_fixed.default.hex]]",
          "leading_diamond": "\ue0b2",
          "options": {
            "charged_icon": "\uf240 ",
            "charging_icon": "\uf1e6 ",
            "discharging_icon": "\ue234 "
          },
          "style": "diamond",
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}\uf295 <[[colors.on_primary_fixed.default.hex]]>\ue0b2</>",
          "type": "battery"
        },
        {
          "background": "[[colors.primary_container.default.hex]]",
          "foreground": "[[colors.on_primary_container.default.hex]]",
          "leading_diamond": "\ue0b2",
          "options": {
            "time_format": "_2,15:04"
          },
          "style": "diamond",
          "template": " \uf073 {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "\ue0b4",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "[[colors.primary.default.hex]]",
          "style": "plain",
          "template": "\u2570\u2500",
          "type": "text"
        },
        {
          "foreground": "[[colors.on_surface.default.hex]]",
          "foreground_templates": ["{{ if gt .Code 0 }}[[colors.error.default.hex]]{{ end }}"],
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "\ue285\ueab6 ",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 4
}
